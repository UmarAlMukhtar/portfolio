{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run lint -- --max-warnings=0 && npm run build && npm test",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "umaralmukhtar.vercel.app" }],
      "destination": "https://umaralmukhtar.dev/:path*",
      "permanent": true
    }
  ]
}
